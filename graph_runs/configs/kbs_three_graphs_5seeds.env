# KBS three-graph rerun defaults.
# Source this file before running graph_runs scripts, or let the scripts load it.

: "${CONDA_ENV:=rm8}"
: "${GPU_ID:=0}"
: "${SEEDS:=0 1 2 3 4}"

# Single RTX 4090: run one seed at a time for stability.
: "${MAX_JOBS:=1}"

# In-training evaluation and curve resolution.
: "${EVAL_GAP:=0}"
: "${EVAL_TIMES:=20}"

# WandB mirror. Local JSONL remains the source of record.
# This account currently has personal entities disabled, so use a verified
# writable team/project by default. Change WANDB_PROJECT after creating the
# formal KBS project in WandB.
: "${WANDB:=1}"
: "${WANDB_PROJECT:=exbody_test}"
: "${WANDB_ENTITY:=goodnight-mkbk-northeastern-university}"
: "${WANDB_GROUP:=}"
: "${WANDB_NOTES:=KBS three graph 5-seed rerun}"

# Shorter graph budget for yb3_9 and yb3_15.
: "${SHORT_BREAK_STEP:=15000000}"
: "${SHORT_TARGET_STEP:=16384}"

# Current first pass: run every selected graph experiment to 15M.
: "${FULL_BREAK_STEP:=15000000}"
: "${FULL_TARGET_STEP:=16384}"
